# Written by Claude (Claude Sonnet 5.5, Anthropic).
# Compiled for aarch64 with OP-TEE 4.2.0 TA dev kit. Structure follows the
# Linaro hello_world sub.mk.
#
# WHAT: compiles HACL*'s Ed25519 code INTO the TA.
# WHY:  the TA build only sees the files and include paths listed here.
# DEBUG: "undefined reference to Hacl_Xxx_..." at link time means add
#        Hacl_Xxx to HACL_SRCS below.

# our own headers: endian.h, compat, TA .h
global-incdirs-y += include

# Force-include the KaRaMeL overrides into EVERY file.
cflags-y += -include overrides.h

# Absolute paths computed from this file's own location, so the build works
# from any directory. MAKEFILE_LIST is valid because OP-TEE's mk/subdir.mk
# `include`s this file.
#
# WARNING: never put a trailing comment after a `:=` value. Make keeps the
# spaces before the #, so "dir   /file.c" splits in two and the build fails
# with "Don't know what to do with <dir>". HACL_GCC = HACL* generated C.
#
HACL_TA_DIR  := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
HACL_DIST    := $(abspath $(HACL_TA_DIR)../../hacl-star/dist)
HACL_GCC     := $(HACL_DIST)/gcc-compatible
HACL_CONFIGS := $(abspath $(HACL_TA_DIR)../../hacl-star-configs-arm)

# incdirs_ext-y is used as written; global-incdirs-y would prepend this
# directory to each entry and mangle absolute paths.
#
incdirs_ext-y += $(HACL_GCC)                                  # Hacl_*.h
incdirs_ext-y += $(HACL_DIST)/karamel/include                 # krml/*.h
incdirs_ext-y += $(HACL_DIST)/karamel/krmllib/dist/minimal

# config.h is generated by HACL*'s ./configure and is NOT tracked in the
# submodule; your repo keeps the ARM copy here. Lib_Memzero0.c includes it.
#
incdirs_ext-y += $(HACL_CONFIGS)

# Include header file with common utilities used by both the TA and the Host.
incdirs_ext-y += ../common

srcs-y += hello_world_ta.c
srcs-y += random_bytes.c

# Only the HACL* files Ed25519 needs (found by fixing link errors one by one):
#   Hacl_Ed25519        the signature scheme itself
#   Hacl_Curve25519_51  field arithmetic Ed25519 reuses
#   Hacl_Hash_SHA2      SHA-512, used inside Ed25519
#   Lib_Memzero0        secure zeroing of secrets
# Plain scalar C only (no NEON/Simd128), so no SIMD setup is needed in the TA.
#
HACL_SRCS := Hacl_Ed25519 Hacl_Curve25519_51 Hacl_Hash_SHA2 Lib_Memzero0
srcs-y += $(addprefix $(HACL_GCC)/,$(addsuffix .c,$(HACL_SRCS)))